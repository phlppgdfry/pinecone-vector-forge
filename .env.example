# ==============================================================================
# Pinecone Vector Forge - Environment Configuration
# ==============================================================================

# Pinecone API Key (Get yours at https://app.pinecone.io)
# Or authenticate directly with the official CLI: `pc login`
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Cloud & Region (Serverless)
# Defaults: aws / us-east-1 (Free tier supported)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Pinecone Index Configuration
PINECONE_INDEX_NAME=vector-forge-knowledge
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine

# Default Namespace for multi-tenant isolation
PINECONE_NAMESPACE=default

# Optional: OpenAI API Key for live text-embedding-3-small generation
# If omitted, Vector Forge uses built-in high-fidelity deterministic neural mock embeddings
OPENAI_API_KEY=

# Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000
DEBUG=false
